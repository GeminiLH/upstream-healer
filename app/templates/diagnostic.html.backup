{% extends "base.html" %}

{% block title %}Diagnostic – Upstream Healer{% endblock %}

{% block content %}
<div class="space-y-8">

  <!-- Header -->
  <div>
    <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100">Diagnostic</h1>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
      View NPM database hosts and available scanner types for troubleshooting.
    </p>
  </div>

  <!-- NPM Hosts Section -->
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
        NPM Database Hosts
        {% if npm_hosts %}
          <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
            {{ npm_hosts|length }} host{{ 's' if npm_hosts|length != 1 }}
          </span>
        {% endif %}
      </h2>
      {% if not npm_available %}
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200">
          Docker not available
        </span>
      {% endif %}
    </div>

    {% if not npm_available %}
      <div class="px-6 py-8 text-center text-sm text-slate-500 dark:text-slate-400">
        Docker is not available on this machine. NPM hosts cannot be queried.
      </div>
    {% elif not npm_hosts %}
      <div class="px-6 py-8 text-center text-sm text-slate-500 dark:text-slate-400">
        No proxy hosts found in the NPM database.
      </div>
    {% else %}
      <details class="group">
        <summary class="cursor-pointer select-none px-6 py-3 flex items-center gap-2 text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/50">
          <svg class="w-4 h-4 text-slate-400 dark:text-slate-500 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <span>Expand {{ npm_hosts|length }} host{{ 's' if npm_hosts|length != 1 }}</span>
        </summary>
      <div class="overflow-x-auto border-t border-slate-200 dark:border-slate-700">
        <table class="min-w-full divide-y divide-slate-200 dark:divide-slate-700">
          <thead class="bg-slate-50 dark:bg-slate-900">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">ID</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Domains</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Forward Host</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Port</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Protocol</th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">SSL</th>
            </tr>
          </thead>
          <tbody class="bg-white dark:bg-slate-800 divide-y divide-slate-200 dark:divide-slate-700">
            {% for host in npm_hosts %}
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-750">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-slate-900 dark:text-slate-100">{{ host.id }}</td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-700 dark:text-slate-300">
                {{ host.domain_names }}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-slate-700 dark:text-slate-300">
                {{ host.forward_host }}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-700 dark:text-slate-300">
                {{ host.forward_port }}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-700 dark:text-slate-300">
                {{ host.forward_scheme or '-' }}
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                {% if host.enabled %}
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-900 dark:text-emerald-200">enabled</span>
                {% else %}
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300">disabled</span>
                {% endif %}
                {% if host.ssl_forced %}
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-sky-100 text-sky-800 dark:bg-sky-900 dark:text-sky-200">ssl forced</span>
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      </details>
    {% endif %}
  </div>

  <!-- Scan Progress Section -->
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Scan Progress</h2>
    </div>
    <div class="px-6 py-4">
      <div id="scan-progress" class="hidden">
        <div class="mb-3">
          <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Elapsed time:</span>
          <span id="elapsed-time" class="ml-2 text-sm text-slate-900 dark:text-slate-100">0s</span>
        </div>
        <div class="mb-3">
          <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Estimated remaining:</span>
          <span id="remaining-time" class="ml-2 text-sm text-slate-900 dark:text-slate-100">0s</span>
        </div>
        <div class="mb-3">
          <span class="text-sm font-medium text-slate-700 dark:text-slate-300">Estimated completion:</span>
          <span id="completion-time" class="ml-2 text-sm text-slate-900 dark:text-slate-100">-</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Run a Scan Section -->
  <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700">
      <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Run a Scan</h2>
    </div>
    <div class="p-6">
      <div class="flex flex-col sm:flex-row gap-4 items-start">
        <div>
          <label for="scan-method" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Scanner</label>
          <select id="scan-method" class="form-control">
            <option value="arp-scan" selected>arp-scan</option>
            <option value="scapy">scapy</option>
            <option value="nmap">nmap (ping sweep)</option>
          </select>
        </div>
        <div class="flex-1 w-full">
          <label for="scan-mac" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Target MAC</label>
          <input type="text" id="scan-mac" placeholder="aa:bb:cc:dd:ee:ff" class="w-full" />
        </div>
        <div>
          <label for="scan-subnet" class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Subnet to sweep</label>
          <select id="scan-subnet" class="form-control">
            <option value="0">All known subnets</option>
            {% for s in subnets %}
              <option value="{{ s.id if s.id else '' }}"
                {% if not s.id %}data-cidr="{{ s.cidr }}"{% endif %}>
                {{ s.name if s.name else s.cidr }} ({{ s.cidr }}{% if s.interface %}, {{ s.interface }}{% endif %}{% if s.source == 'auto' %}, auto{% endif %})
              </option>
            {% endfor %}
          </select>
        </div>
        <div class="sm:self-end">
          <label class="inline-flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300 cursor-pointer select-none pb-2">
            <input type="checkbox" id="scan-ports" checked class="w-4 h-4" />
            Scan open ports
          </label>
        </div>
        <button id="scan-run" type="button"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-brand-500 hover:bg-brand-600 text-white text-sm font-medium transition disabled:opacity-50 disabled:cursor-not-allowed sm:self-end">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H12" />
          </svg>
          <span id="scan-run-label">Run scan</span>
        </button>
      </div>
      <p id="scan-method-desc" class="mt-2 text-xs text-slate-500 dark:text-slate-400"></p>

      {% if hosts %}
        <div class="mt-4">
          <span class="text-xs uppercase tracking-wider text-slate-400 dark:text-slate-500">Known hosts — click to prefill:</span>
          <div class="mt-2 flex flex-wrap gap-2">
            {% for h in hosts %}
              <button type="button" data-mac="{{ h.mac_address }}" data-name="{{ h.name }}" aria-pressed="false"
                class="kh-btn text-xs px-2.5 py-1 rounded-md border border-slate-200 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300 hover:border-brand-400 transition">
                {{ h.name }}
              </button>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      <div id="scan-result" class="hidden mt-5">
        <div id="scan-status" class="mb-2 text-sm"></div>
        <div class="flex justify-end mb-2">
          <button id="scan-log-btn" type="button"
            class="text-xs text-slate-500 dark:text-slate-400 underline hover:text-brand-500 transition">
            Scan debug log
          </button>
        </div>
        <pre id="scan-log"
          class="hidden mb-3 bg-slate-900 text-slate-300 text-[11px] font-mono p-4 rounded-lg overflow-auto max-h-96 whitespace-pre-wrap"></pre>
        <div id="scan-hosts-wrap" class="hidden mb-3">
          <span class="text-xs uppercase tracking-wider text-slate-400 dark:text-slate-500">
            Hosts seen on the swept network(s): <span id="scan-hosts-count"></span>
          </span>
          <div class="mt-2 overflow-x-auto">
            <table class="min-w-full text-sm">
              <thead class="bg-slate-50 dark:bg-slate-900">
                <tr class="text-left text-xs uppercase text-slate-500 dark:text-slate-400">
                  <th class="px-3 py-2">Hostname</th>
                  <th class="px-3 py-2">IP</th>
                  <th class="px-3 py-2">MAC</th>
                  <th class="px-3 py-2">Info</th>
                  <th class="px-3 py-2">Ports</th>
                </tr>
              </thead>
              <tbody id="scan-hosts" class="divide-y divide-slate-200 dark:divide-slate-700 bg-white dark:bg-slate-800"></tbody>
            </table>
          </div>
          <p class="mt-1.5 text-[11px] text-slate-400 dark:text-slate-500"><span class="routed-badge">routed</span> = reached via an L3 route (e.g. a WireGuard/tunnel or gateway), not a local ARP segment, so its source MAC isn't visible and shows <code>--</code>.</p>
        </div>
        <div class="mt-2 text-xs uppercase tracking-wider text-slate-400 dark:text-slate-500">Raw output</div>
        <pre id="scan-output"
          class="bg-slate-900 text-slate-100 text-xs font-mono p-4 rounded-lg overflow-auto max-h-96 whitespace-pre-wrap"></pre>
      </div>
    </div>
  </div>

</div>

<style>
  /* Known-host prefill buttons: highlight the one whose MAC is in the Target
     MAC field (toggled by JS below). `!important` beats the Tailwind utilities
     on the same element; works in both light and dark mode. */
  .kh-btn {
    transition: background-color 0.15s ease, border-color 0.15s ease,
      color 0.15s ease, box-shadow 0.15s ease;
  }
  .kh-btn.kh-active {
    border-color: #0ea5e9 !important;
    background-color: #e0f2fe !important;
    color: #075985 !important;
    box-shadow: 0 0 0 1px #0ea5e9;
  }
  .dark .kh-btn.kh-active {
    border-color: #38bdf8 !important;
    background-color: rgba(12, 74, 110, 0.5) !important;
    color: #bae6fd !important;
    box-shadow: 0 0 0 1px #38bdf8;
  }
  /* "routed" pill: marks hosts reached over an L3 route (WireGuard/tunnel or
     gateway) whose source MAC is invisible behind the tunnel, so MAC shows --. */
  .routed-badge {
    display: inline-block;
    margin-left: 0.375rem;
    padding: 0.1rem 0.4rem;
    border-radius: 9999px;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    vertical-align: middle;
    color: #075985;
    background-color: #e0f2fe;
    border: 1px solid #bae6fd;
  }
  .dark .routed-badge {
    color: #bae6fd;
    background-color: rgba(12, 74, 110, 0.5);
    border-color: rgba(56, 189, 248, 0.4);
  }
</style>

<script>
  (function () {
    const methodEl = document.getElementById('scan-method');
    const macEl = document.getElementById('scan-mac');
    const subnetEl = document.getElementById('scan-subnet');
    const runBtn = document.getElementById('scan-run');
    const runLabel = document.getElementById('scan-run-label');
    const resultEl = document.getElementById('scan-result');
    const statusEl = document.getElementById('scan-status');
    const outputEl = document.getElementById('scan-output');
    const hostsWrap = document.getElementById('scan-hosts-wrap');
    const hostsBody = document.getElementById('scan-hosts');
    const hostsCount = document.getElementById('scan-hosts-count');
    const methodDescEl = document.getElementById('scan-method-desc');
    const portsEl = document.getElementById('scan-ports');
    const logBtn = document.getElementById('scan-log-btn');
    const logEl = document.getElementById('scan-log');

    function esc(v) {
      const d = document.createElement('div');
      d.textContent = v == null ? '' : String(v);
      return d.innerHTML;
    }

    const METHOD_DESCS = {
      'arp-scan': 'Fast and reliable on Linux — sweeps the subnet with the arp-scan binary.',
      'scapy': 'Python-based fallback — sends ARP requests directly via scapy.',
      'nmap': 'Host discovery with nmap (ICMP/ping sweep). ARP-routable subnets are still swept in parallel.',
    };

    function syncMethodDesc() {
      if (!methodDescEl) return;
      const text = METHOD_DESCS[methodEl.value] || '';
      methodDescEl.textContent = text;
      methodDescEl.style.display = text ? '' : 'none';
    }

    // "Scan debug log": the backend keeps one detailed file per diagnostic
    // scan (exact tool commands, full raw output, hostname maps).  Fetch the
    // newest one on demand; toggles the panel off on the second click.
    if (logBtn && logEl) {
      logBtn.addEventListener('click', async () => {
        if (!logEl.classList.contains('hidden')) {
          logEl.classList.add('hidden');
          return;
        }
        logEl.textContent = 'Loading…';
        logEl.classList.remove('hidden');
        try {
          const resp = await fetch('/api/diagnostic/scan-log');
          if (!resp.ok) {
            let msg = `Scan logging unavailable (HTTP ${resp.status})`;
            try { msg += ` — ${resp.json().detail}`; } catch (e) { /* keep default */ }
            logEl.textContent = msg + '. Run a scan on the dev stack to generate a log.';
            return;
          }
          const data = await resp.json();
          if (!data.latest || !data.latest.content) {
            logEl.textContent = 'No scan log yet — run a scan first, then open the debug log again.';
            return;
          }
          logEl.textContent = `== ${data.latest.name} (${data.latest.mtime}, ${data.latest.size} bytes) ==\n` +
            data.latest.content;
        } catch (err) {
          logEl.textContent = `Failed to load scan log: ${err}`;
        }
      });
    }

    // Canonicalise a MAC the same way the backend does (lowercase, colon
    // separated); a 32-hex Intel EUI-64 value reduces to its last 12 hex.
    function normMac(v) {
      if (!v) return '';
      let s = String(v).toLowerCase().replace(/[^0-9a-f]/g, '');
      if (s.length === 32) s = s.slice(-12);
      if (s.length !== 12) return s;
      return s.replace(/(.{2})(?=.)/g, '$1:');
    }

    // Highlight the known-host button whose MAC matches the Target MAC field.
    function syncKnownHosts() {
      const target = normMac(macEl.value);
      document.querySelectorAll('.kh-btn').forEach((btn) => {
        const active = !!target && target === normMac(btn.getAttribute('data-mac'));
        btn.classList.toggle('kh-active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    }

    function clearHosts() {
      hostsBody.innerHTML = '';
      hostsCount.textContent = '';
      hostsWrap.classList.add('hidden');
    }

    function _selectedSubnetId() {
      // Manual rows have a numeric id; auto rows have data-cidr but no id.
      // We send subnet_id=0 to mean "all known"; the server resolves either
      // way via list_subnets().
      const v = subnetEl ? subnetEl.value : "0";
      return v === "" ? 0 : Number(v);
    }

    // Update the scan function to track scan ID and monitor progress
    const originalRunScan = runBtn.onclick;
    runBtn.onclick = async function(e) {
      e.preventDefault();
      
      // Clear previous scan progress
      clearInterval(scanProgressInterval);
      scanProgressDiv.classList.add('hidden');
      
      const mac = macEl.value.trim();
      const method = methodEl.value;
      const subnetId = _selectedSubnetId();
      // Auto-detected subnets have no DB id; the server scopes by CIDR.
      const subnetCidr = subnetEl ? ((subnetEl.selectedOptions[0] || {}).dataset?.cidr || "") : "";
      const scope = subnetId ? subnetId : subnetCidr;
      const scanPorts = portsEl ? portsEl.checked : false;
      runBtn.disabled = true;
      runLabel.textContent = 'Running…';
      statusEl.textContent = `Running ${method}${mac ? ' for ' + mac : ''}${scope ? ' on ' + scope : ''}${scanPorts ? ' (scanning open ports…)' : ''}`;
      statusEl.className = 'mb-2 text-sm text-slate-500 dark:text-slate-400';
      resultEl.classList.remove('hidden');
      outputEl.textContent = '…';
      clearHosts();
      try {
        const res = await fetch('/api/diagnostic/scan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ target_mac: mac, method: method, subnet_id: subnetId, subnet_cidr: subnetCidr, scan_ports: scanPorts }),
        });
        const data = await res.json();
        if (!res.ok) {
          statusEl.textContent = `Error: ${data.detail || res.status}`;
          statusEl.className = 'mb-2 text-sm text-rose-600 dark:text-rose-400';
          outputEl.textContent = '';
          return;
        }
        
        // Start monitoring scan progress
        const scanId = data.scan_id;  // This would be the ID from the API response
        if (scanId) {
          scanProgressInterval = setInterval(() => updateScanProgress(scanId), 1000);
        }
        
        const foundCount = (data.hosts || []).length;
        let statusMsg;
        let statusCls = 'mb-2 text-sm';
        if (data.error) {
          statusMsg = `${method}: ${data.error}`;
          statusCls += ' text-rose-600 dark:text-rose-400';
        } else if (data.found_ip) {
          const fh = (data.hosts || []).find((h) => h.ip === data.found_ip);
          statusMsg = `Found ${mac} at ${data.found_ip}` +
            (fh && fh.hostname ? ` (${fh.hostname})` : '') + ` (via ${data.found_via})`;
          statusCls += ' text-emerald-600 dark:text-emerald-400';
        } else if (mac) {
          statusMsg = `No match for ${mac} (${method} finished)`;
          statusCls += ' text-amber-600 dark:text-amber-400';
        } else {
          statusMsg = `Sweep complete: ${foundCount} host${foundCount === 1 ? '' : 's'} found (${method})`;
          statusCls += ' text-emerald-600 dark:text-emerald-400';
        }
        if (data.ports_error) {
          statusMsg += ` · ${data.ports_error}`;
        }
        statusEl.textContent = statusMsg;
        statusEl.className = statusCls;
        outputEl.textContent = data.output || '(no output)';
        const hosts = data.hosts || [];
        const fmtPorts = (h) => {
          const list = (h.ports || []).map((p) =>
            `${p.port}/${p.protocol || 'tcp'}${p.service ? ' ' + p.service : ''}`);
          return list.length ? list.join(', ') : '';
        };
        hostsBody.innerHTML = hosts.map((h) => {
          const ports = fmtPorts(h);
          return `<tr class="text-slate-700 dark:text-slate-200">
            <td class="px-3 py-1.5 font-mono">${h.hostname ? esc(h.hostname) : '<span class="text-slate-400 dark:text-slate-600">—</span>'}</td>
            <td class="px-3 py-1.5 font-mono">${esc(h.ip)}</td>
            <td class="px-3 py-1.5 font-mono">${h.mac ? esc(h.mac) : '<span class="text-slate-400 dark:text-slate-600">--</span> <span class="routed-badge" title="Reached via an L3 route (WireGuard/tunnel or gateway), not a local ARP segment">routed</span>'}</td>
            <td class="px-3 py-1.5 text-xs text-slate-500 dark:text-slate-400">${esc(h.detail)}</td>
            <td class="px-3 py-1.5 text-xs font-mono text-slate-600 dark:text-slate-300">${ports ? esc(ports) : '<span class="text-slate-400 dark:text-slate-600">—</span>'}</td>
          </tr>`;
        }).join('');
        hostsCount.textContent = `(${hosts.length})`;
        hostsWrap.classList.toggle('hidden', !hosts.length);
      } catch (err) {
        statusEl.textContent = `Request failed: ${err}`;
        statusEl.className = 'mb-2 text-sm text-rose-600 dark:text-rose-400';
        outputEl.textContent = '';
      } finally {
        runBtn.disabled = false;
        runLabel.textContent = 'Run scan';
      }
    };

    // Add timing functionality
    let scanProgressInterval = null;
    const scanProgressDiv = document.getElementById('scan-progress');
    const elapsedTimeSpan = document.getElementById('elapsed-time');
    const remainingTimeSpan = document.getElementById('remaining-time');
    const completionTimeSpan = document.getElementById('completion-time');

    function updateScanProgress(scanId) {
      if (!scanId) return;
      
      fetch(`/api/diagnostic/scan-progress/${scanId}`)
        .then(res => res.json())
        .then(data => {
          if (data.error) {
            // Stop the interval if scan is complete or error
            clearInterval(scanProgressInterval);
            return;
          }
          
          // Update timing information
          elapsedTimeSpan.textContent = `${data.elapsed_time}s`;
          
          if (data.estimated_remaining !== null) {
            remainingTimeSpan.textContent = `${Math.max(0, data.estimated_remaining).toFixed(1)}s`;
          } else {
            remainingTimeSpan.textContent = 'Calculating...';
          }
          
          if (data.estimated_completion) {
            const completionDate = new Date(data.estimated_completion * 1000);
            completionTimeSpan.textContent = completionDate.toLocaleTimeString();
          } else {
            completionTimeSpan.textContent = '-';
          }
          
          // Show progress section
          scanProgressDiv.classList.remove('hidden');
        })
        .catch(err => {
          console.error('Error fetching scan progress:', err);
        });
         .catch(err => {
         });
     }
     
     // Enhanced error handling for scan ID validation
     function startScanWithProgress(targetMac, method, subnetId, scanPorts) {
       // Validate inputs
       if (!targetMac && !subnetId) {
         statusEl.textContent = 'Please enter a MAC address or select a subnet.';
         statusEl.className = 'mb-2 text-sm text-rose-600 dark:text-rose-400';
         return;
       }
       
       // Reset UI
       runBtn.disabled = true;
       runLabel.textContent = 'Scanning...';
       outputEl.textContent = '';
       statusEl.textContent = '';
       hostsWrap.classList.add('hidden');
       scanProgressDiv.classList.add('hidden');
       
       fetch('/api/diagnostic/scan', {
         method: 'POST',
         headers: { 'Content-Type': 'application/json' },
         body: JSON.stringify({
           target_mac: targetMac,
           method,
           subnet_id: subnetId || null,
           scan_ports: scanPorts
         })
       })
       .then(res => res.json())
       .then(data => {
         if (!res.ok) {
           throw new Error(data.detail || 'Scan failed');
         }
         
         // Check for scan_id in the response
         if (!data.scan_id) {
           throw new Error('No scan ID returned from server');
         }
         
         const scanId = data.scan_id;
         
         // Update UI with scan information
         statusEl.textContent = `Scan started with ID: ${scanId}`;
         statusEl.className = 'mb-2 text-sm text-slate-600 dark:text-slate-300';
         
         // Start polling for progress
         let scanProgressInterval = setInterval(() => {
           updateScanProgress(scanId);
         }, 1000); // Poll every second
       })
       .catch(err => {
         statusEl.textContent = `Request failed: ${err.message}`;
         statusEl.className = 'mb-2 text-sm text-rose-600 dark:text-rose-400';
         outputEl.textContent = '';
         console.error('Scan error:', err);
       })
       .finally(() => {
         runBtn.disabled = false;
         runLabel.textContent = 'Run scan';
       });
     }
     
     document.querySelectorAll('.kh-btn').forEach((btn) => {
       btn.addEventListener('click', () => {
         macEl.value = btn.getAttribute('data-mac');
         syncKnownHosts();
       });
     });
    }

    document.querySelectorAll('.kh-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        macEl.value = btn.getAttribute('data-mac');
        syncKnownHosts();
      });
    });
    macEl.addEventListener('input', syncKnownHosts);
    methodEl.addEventListener('change', syncMethodDesc);
    syncMethodDesc();
    syncKnownHosts();
  })();
</script>
{% endblock %}
